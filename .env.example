# Copy to .env and fill in the keys you have. Every backend reads its own var.

# Google AI Studio — free tier (attacker/judge in v1)
GEMINI_API_KEY=

# Groq — free tier, open-weight models (Llama 3.3 70B, gpt-oss-120b, Kimi K2)
# https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — free tier via `:free` model slugs
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Paid frontier models, for later comparison runs
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama needs no key — just a running local server at http://localhost:11434
